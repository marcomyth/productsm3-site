# Supabase — site content + blog (src/lib/content.ts). Ver README > Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Usada por scripts/seed-supabase.ts E pelas rotas de ingest em
# src/app/api/ (src/lib/supabase-admin.ts) — precisa estar configurada em
# todo ambiente que recebe posts do Ascendly, não só localmente.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token exigido pelo Ascendly em /api/blog-posts e /api/upload. Gere
# com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLOG_INGEST_TOKEN=
